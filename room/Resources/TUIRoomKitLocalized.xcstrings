{
  "sourceLanguage": "en",
  "strings": {
    "roomkit.chat.muted": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已被禁言，暂时无法发送消息"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have been muted and cannot send messages"
          }
        }
      }
    },
    "roomkit.chat.muted_all": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前会议已开启全员禁言"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone is muted in this meeting"
          }
        }
      }
    },
    "roomkit.cloud_recording.ended": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端录制已结束"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud recording ended"
          }
        }
      }
    },
    "roomkit.cloud_recording.ended_abnormal": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端录制异常结束"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud recording ended unexpectedly"
          }
        }
      }
    },
    "roomkit.cloud_recording.notify_cancel": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开房间"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave Room"
          }
        }
      }
    },
    "roomkit.cloud_recording.notify_confirm": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我知道了"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Got it"
          }
        }
      }
    },
    "roomkit.cloud_recording.notify_content": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@开启了云端录制，房间中的音视频画面、共享屏幕内容将会被录制。如果留在房间中，表示您同意录制。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ started cloud recording. Audio, video, and shared screen content in the room will be recorded. By staying in the room, you consent to being recorded."
          }
        }
      }
    },
    "roomkit.cloud_recording.notify_title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端录制中"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud recording in progress"
          }
        }
      }
    },
    "roomkit.cloud_recording.record_label": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record"
          }
        }
      }
    },
    "roomkit.cloud_recording.recording_label": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制中"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording"
          }
        }
      }
    },
    "roomkit.cloud_recording.start_confirm": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启录制"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Recording"
          }
        }
      }
    },
    "roomkit.cloud_recording.start_content": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，将录制房间中的音视频画面、共享屏幕内容到云端，并告知所有参会成员"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once enabled, the room's audio/video and shared screen content will be recorded to the cloud, and all participants will be notified."
          }
        }
      }
    },
    "roomkit.cloud_recording.start_title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是否开启云端录制？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start cloud recording?"
          }
        }
      }
    },
    "roomkit.cloud_recording.started_toast": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制已开始 · 云端保存"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording started and saved to the cloud"
          }
        }
      }
    },
    "roomkit.cloud_recording.stop_confirm": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束录制"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop recording"
          }
        }
      }
    },
    "roomkit.cloud_recording.stop_content": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束录制后，将停止录制房间中的音视频画面、共享屏幕内容到云端，并告知所有参会成员"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once stopped, audio/video and shared screen content will no longer be recorded. All participants will be notified."
          }
        }
      }
    },
    "roomkit.cloud_recording.stop_title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束云端录制？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop cloud recording?"
          }
        }
      }
    },
    "roomkit.cloud_recording.stopped_toast": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制已停止"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording stopped"
          }
        }
      }
    },
    "roomkit.common.back": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回"
          }
        },
