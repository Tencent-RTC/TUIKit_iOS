    "roomkit.device.all_cam_disabled": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全员禁画中，无法打开摄像头"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video is disabled for everyone, so the camera cannot be turned on"
          }
        }
      }
    },
    "roomkit.device.all_mic_disabled": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全员静音中，无法打开麦克风"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone is muted, so the microphone cannot be turned on"
          }
        }
      }
    },
    "roomkit.device.audio_interrupted": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频采集设备不可用，可能被系统电话或其他应用占用"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio capture device is unavailable. It may be in use by a phone call or another app"
          }
        }
      }
    },
    "roomkit.device.camera_no_device": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检测到摄像头设备"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera device detected"
          }
        }
      }
    },
    "roomkit.device.camera_no_permission": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头权限未开启，请在系统设置中允许访问摄像头"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is not granted. Please allow camera access in system settings"
          }
        }
      }
    },
    "roomkit.device.camera_occupied": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头被其他应用占用，请关闭后重试"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is in use by another app. Please close it and try again"
          }
        }
      }
    },
    "roomkit.device.camera_start_failed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
